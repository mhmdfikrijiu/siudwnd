# Copy this file to .env on the VPS. Do not commit the completed .env file.
# All credentials below must be created/revoked privately, never pasted into chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Local Bot API Server is used by docker-compose.local-api.yml for files up to 1.9 GB.
TELEGRAM_MAX_UPLOAD_MB=1900
TELEGRAM_MAX_CONCURRENT_DOWNLOADS=2
TELEGRAM_JOB_TTL_MINUTES=180

# Web downloader cache: maximum 1 GB; cached episode files expire after two hours.
NARTO_CACHE_MAX_MB=1024
NARTO_CACHE_TTL_HOURS=2
NARTO_BASE_PATH=/narto
PORT=5000
